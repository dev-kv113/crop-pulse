# Copy this file to `.env` and adjust. `.env` is git-ignored.

# ---------------------------------------------------------------- database ---
# Port 5433 matches docker-compose.yml (host port), so this works when you run
# the API on your machine and the database in Docker.
DATABASE_URL=postgresql://croppulse:croppulse@localhost:5433/croppulse

# Connections this API process keeps open to PostgreSQL. Each serves one request
# at a time, and a request takes a few milliseconds, so 10 handles a lot of
# users. Raise under real traffic, but keep (instances x DB_POOL_MAX) below the
# database's own max_connections (100 by default).
DB_POOL_MIN=1
DB_POOL_MAX=10

# ------------------------------------------------------------------- auth ---
# CHANGE THIS before deploying anywhere. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
# How long a staff session lasts (admin, read-only admin, unit head).
JWT_EXPIRY_HOURS=720
# How long a farmer stays signed in. 87600 hours is ten years, i.e. "until they
# sign out" -- one OTP, then the app just opens, the way a phone app should.
# Raise JWT_EXPIRY_HOURS to this too if you want staff to behave the same.
FARMER_JWT_EXPIRY_HOURS=87600

# Comma-separated phone numbers that get the admin role at login.
# These do not need to exist in any uploaded file.
ADMIN_PHONES=+919999999999

# ------------------------------------------------------------------- OTP -----
# "console" -> the OTP is printed to the API log and returned in the API
#              response, so you can log in locally with no SMS provider.
# Swap to a real provider by adding one here (see app/sms.py).
SMS_PROVIDER=console

# --- MSG91, used only when SMS_PROVIDER=msg91 ------------------------------
# The auth key is a secret and is deliberately NOT set here. Put it in the
# secrets directory instead -- one file named `msg91_auth_key` holding just the
# key, on a path outside this repository (see SECRETS_DIR in the .env beside
# docker-compose.yml).
#
# Leave the line below commented out. An empty `MSG91_AUTH_KEY=` is still a
# value as far as settings are concerned, and it would silently shadow the
# secrets file -- the app would start with no key and refuse to send anything.
# MSG91_AUTH_KEY=
# DLT-registered header, approved alongside the template.
MSG91_SENDER_ID=GEOTRN
# MSG91's OWN id for the flow, from their panel -- a 24-character hex string.
# NOT the DLT template id (1777178749413726643), which is the 19-digit number
# registered with SmartPing. MSG91 already knows that one; it holds the mapping.
MSG91_TEMPLATE_ID=6a8c5a06235d7ea171092d72
# The variable in that flow that carries the code.
MSG91_OTP_VAR=OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Google Play review sign-in --------------------------------------------
# Google will not approve an app behind a sign-in without a way for reviewers to
# get in, and a reviewer outside India cannot receive an Indian OTP. Setting
# both of these makes ONE number use a fixed code that is never sent by SMS.
#
# The number must also be enrolled normally (a demo farmer, or a read-only
# admin) -- this only changes how its code is made and delivered, not who it is.
# Treat the pair as a password, and clear both once review is done.
# Leave blank to disable, which is the default.
REVIEW_PHONE=
REVIEW_OTP=

# ------------------------------------------------------------------ files ----
UPLOAD_DIR=./var/uploads

# ------------------------------------------------------------------- CORS ----
# Where the web frontend runs. Add your deployed domain when you go live.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Development convenience: also accept any private-network address, so you can
# open the app on your phone at http://<your-computer-ip>:5174 without editing
# this file every time your IP changes.
#
# DELETE THIS LINE IN PRODUCTION. There, the exact list above is the point.
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|10\.[0-9.]+|192\.168\.[0-9.]+|172\.(1[6-9]|2[0-9]|3[01])\.[0-9.]+)(:[0-9]+)?$
