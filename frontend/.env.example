# Copy to `.env` (git-ignored) and adjust.

# Where the backend lives.
#
# Web browser on this machine .... http://localhost:8010
# Phone browser on your wi-fi .... http://<your-computer-ip>:8010
# Android app (emulator) ......... http://10.0.2.2:8010
# Android app (real device) ...... http://<your-computer-ip>:8010
# Production ..................... not used: the Docker image is built with
#                                  this empty, so the app calls /api on its own domain
#
# A packaged Android app has no "localhost" of its own to talk to, so this must
# be a real address the phone can reach.
VITE_API_BASE_URL=http://localhost:8010

# Where the crop monitoring dashboard lives.
#
# A separate app, framed on the unit head's screen. Each unit is pointed at one
# of its mills by a short code set in Admin -> Unit, so only the address goes
# here. Leave it unset to use the address below.
# VITE_ANALYTICS_URL=https://analytics.geotranstech.com

# Optional: sharper satellite imagery.
#
# The default provider (Esri World Imagery) is free and needs no key, but in
# rural India its detail stops at zoom 18 -- roughly 0.6 m per pixel. Past that
# the app upscales the last real tile rather than showing Esri's grey
# "Map data not yet available" placeholder.
#
# For sharper imagery, get a free key at https://www.maptiler.com and set it
# here. Nothing else needs to change.
# VITE_MAPTILER_KEY=your_key_here
