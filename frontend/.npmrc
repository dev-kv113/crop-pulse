# This project uses the public npm registry.
#
# Without this file, npm picks up whatever registry is set in your global
# ~/.npmrc -- on this machine that is a private IBM Artifactory mirror, whose
# credentials are unrelated to this project and expire.
registry=https://registry.npmjs.org/

# The global config sets package-lock=false. A lockfile is what makes an install
# reproducible on another machine and in CI, so turn it back on here.
package-lock=true
